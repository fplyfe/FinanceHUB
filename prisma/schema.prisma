generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  WALLET
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TxStatus {
  PENDING
  PAID
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions      Transaction[]
  installmentPlans  InstallmentPlan[]
  recurrings        Recurring[]
  goalContributions GoalContribution[]
}

model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType @default(CHECKING)
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  color          String      @default("#6366f1")
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions      Transaction[]    @relation("TxAccount")
  incomingTransfers Transaction[]    @relation("TxToAccount")
  cards             CreditCard[]
  recurrings        Recurring[]
  installmentPlans  InstallmentPlan[]
}

model CreditCard {
  id           String   @id @default(cuid())
  name         String
  brand        String?
  limit        Decimal  @db.Decimal(14, 2)
  closingDay   Int
  dueDay       Int
  color        String   @default("#8b5cf6")
  archived     Boolean  @default(false)
  payAccountId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payAccount       Account?          @relation(fields: [payAccountId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  recurrings       Recurring[]
  installmentPlans InstallmentPlan[]
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  color     String       @default("#64748b")
  createdAt DateTime     @default(now())

  transactions     Transaction[]
  recurrings       Recurring[]
  installmentPlans InstallmentPlan[]

  @@unique([name, type])
}

model Transaction {
  id                String   @id @default(cuid())
  type              TxType
  description       String
  amount            Decimal  @db.Decimal(14, 2)
  date              DateTime @db.Date
  status            TxStatus @default(PENDING)
  notes             String?
  accountId         String?
  toAccountId       String?
  cardId            String?
  categoryId        String?
  userId            String
  installmentPlanId String?
  installmentNumber Int?
  recurringId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account         Account?         @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount       Account?         @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  card            CreditCard?      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  recurring       Recurring?       @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([accountId])
  @@index([cardId, status])
  @@index([categoryId])
  @@index([installmentPlanId])
}

model InstallmentPlan {
  id          String   @id @default(cuid())
  description String
  totalAmount Decimal  @db.Decimal(14, 2)
  installments Int
  firstDate   DateTime @db.Date
  accountId   String?
  cardId      String?
  categoryId  String?
  userId      String
  createdAt   DateTime @default(now())

  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card         CreditCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
}

model Recurring {
  id          String    @id @default(cuid())
  description String
  type        TxType
  amount      Decimal   @db.Decimal(14, 2)
  frequency   Frequency @default(MONTHLY)
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  nextDate    DateTime  @db.Date
  autoPay     Boolean   @default(false)
  active      Boolean   @default(true)
  accountId   String?
  cardId      String?
  categoryId  String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card         CreditCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([active, nextDate])
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @db.Decimal(14, 2)
  deadline      DateTime? @db.Date
  color         String    @default("#10b981")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contributions GoalContribution[]
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([goalId])
}
