# ===== FinanceHub - variáveis de ambiente =====
# Copie para .env e ajuste. NUNCA commite o .env.

# Domínio público (usado pelo Nginx/Let's Encrypt)
DOMAIN=financeiro.exemplo.com
LETSENCRYPT_EMAIL=voce@exemplo.com

# Banco de dados
POSTGRES_USER=financehub
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=financehub
# Em desenvolvimento local (fora do Docker) aponte para localhost:
DATABASE_URL=postgresql://financehub:troque-por-uma-senha-forte@localhost:5432/financehub?schema=public

# Autenticação (gere com: openssl rand -base64 48)
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-48-bytes-ou-mais
# true quando servir via HTTPS (produção). Em http://localhost deixe false.
COOKIE_SECURE=false

# Fuso horário da aplicação
APP_TZ=America/Sao_Paulo

# Usuários iniciais (criados pelo seed; só são criados se não existirem)
USER1_NAME=Usuário 1
USER1_EMAIL=usuario1@exemplo.com
USER1_PASSWORD=troque-esta-senha-1
USER2_NAME=Usuário 2
USER2_EMAIL=usuario2@exemplo.com
USER2_PASSWORD=troque-esta-senha-2

# Backups
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
